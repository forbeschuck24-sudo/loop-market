# Copy this file to .env and fill in your own keys. Never commit .env.
STRIPE_SECRET_KEY=sk_test_paste_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_paste_your_webhook_secret_here

# Revenue levers (tune these; see README "Tuning the revenue levers")
PLATFORM_FEE_PERCENT=10
# Flat handling fee per order, collected automatically on top of the percent cut
HANDLING_FEE_CENTS=30
PROMOTED_LISTING_PRICE_CENTS=499
PROMOTED_LISTING_DAYS=7
PREMIUM_MONTHLY_CENTS=999
# Optional: use an existing Stripe Price for the premium tier instead of
# letting the server create one automatically.
# PREMIUM_PRICE_ID=price_123...

# Optional: the server serves the app itself, so Stripe redirect URLs default to
# the server's own public URL. Set this only if the app lives elsewhere.
# CLIENT_URL=https://your-loop-market-app-url
PORT=4242

# Owner token: protects /api/revenue and /api/sales from public eyes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Paste the same value in the app under Account → Settings → Owner token.
# Leave empty for local dev only.
# OWNER_TOKEN=paste_long_random_string_here
